+/* Between two chains of equal quality, Windows prefers the one whose issuer is
+ * the most recent certificate (latest NotBefore) where the chains first
+ * differ, e.g. a cross-signed root shipped with a signature (2022) over an
+ * older self-signed copy of the same root (2013).  Returns TRUE if alternate
+ * should be preferred over chain.
+ */
+static BOOL CRYPT_AlternateHasNewerIssuer(const CertificateChain *chain,
+ const CertificateChain *alternate)
+{
+    DWORD i, j;
+
+    for (i = 0; i < chain->context.cChain && i < alternate->context.cChain; i++)
+    {
+        const CERT_SIMPLE_CHAIN *a = chain->context.rgpChain[i];
+        const CERT_SIMPLE_CHAIN *b = alternate->context.rgpChain[i];
+
+        for (j = 0; j < a->cElement && j < b->cElement; j++)
+        {
+            PCCERT_CONTEXT ca = a->rgpElement[j]->pCertContext;
+            PCCERT_CONTEXT cb = b->rgpElement[j]->pCertContext;
+
+            if (!CertCompareCertificate(X509_ASN_ENCODING, ca->pCertInfo,
+             cb->pCertInfo))
+                return CompareFileTime(&cb->pCertInfo->NotBefore,
+                 &ca->pCertInfo->NotBefore) > 0;
+        }
+    }
+    return FALSE;
+}
