---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import TransitLog from '../components/TransitLog.astro';
import AppTour from '../components/AppTour.astro';
import CompatBoard from '../components/CompatBoard.astro';
import Notice from '../components/Notice.astro';
import Compare from '../components/Compare.astro';
import Install from '../components/Install.astro';
import Footer from '../components/Footer.astro';
import { loadSnapshot } from '../data/catalog';
import { short, type Game } from '../scripts/catalog';

const games = Object.values(loadSnapshot().files).map((f) => f.game).filter((g): g is Game => !!g);
// the hero's travellers: tested Quest games that work, most recently checked first
const crossing = games
  .filter((g) => g.status === 'works' && g.platform === 'Quest' && g.package && g.engine && g.xr && g.title.length <= 24)
  .sort((a, b) => b.checked.localeCompare(a.checked) || a.title.localeCompare(b.title))
  .slice(0, 10)
  .map(({ title, package: pkg, engine, xr }) => ({ title, package: pkg, engine, xr }));
// the app demo's library: tested titles (mostly working, one with issues, one PC VR game when there is one)
const pick = (pred: (g: Game) => boolean, n: number) => games.filter(pred).sort((a, b) => a.title.localeCompare(b.title)).slice(0, n);
const mockGames = [
  ...pick((g) => g.status === 'works' && g.platform === 'Quest' && g.title.length <= 22 && !crossing.slice(0, 2).some((c) => c.title === g.title), 9),
  ...pick((g) => g.status === 'issues' && g.platform === 'Quest' && g.title.length <= 22, 1),
  ...pick((g) => g.status === 'works' && g.platform === 'PC VR', 1),
].map(({ title, engine, xr, status, platform }) => ({ title, engine, xr, status: status as 'works' | 'issues', platform }));
// the install log follows one real recipe
const example = games.find((g) => g.package === 'com.Armature.VR4') ?? games.find((g) => g.status === 'works')!;
const asLog = (g: Game) => ({ title: g.title, package: g.package, engine: g.engine, xr: g.xr, verified: g.checked,
  patches: g.patches, version: g.version, app: g.app, note: g.status === 'works' ? short(g.details) : g.note });
const logGames = games.filter((g) => g.status !== 'unsupported' && g.platform === 'Quest' && g.engine && g.xr).map(asLog);
---
<Layout
  title="FramePort · VR games on your Steam Frame"
  description="FramePort converts, patches and installs Meta Quest games, Android apps and PC VR games on the Valve Steam Frame and adds them to your Steam library. Free and open source.">
  <Nav />
  <main>
    <Hero games={crossing} />
    <TransitLog example={asLog(example)} others={logGames} />
    <AppTour games={mockGames} />
    <CompatBoard />
    <Compare />
    <Notice />
    <Install />
  </main>
  <Footer />
</Layout>
