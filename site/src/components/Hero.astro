---
import Crossing, { type CrossingGame } from './Crossing.astro';
import Glyph from './Glyph.astro';
import { DOWNLOADS, RELEASES, downloadPage } from '../data/site';

interface Props { games: CrossingGame[] }
const { games } = Astro.props;
---
<section class="hero">
  <div class="hero-in wrap">
    <div class="copy">
      <h1>Your <span class="q">VR games</span>, on the <span class="f">Steam Frame</span></h1>
      <p class="lead">
        FramePort puts Quest games, PC VR games, Android apps and Linux apps on the Steam Frame and in your Steam
        library. Connect the Frame once; then each game is one click.
      </p>
      <div class="ctas">
        <a class="btn btn-primary" href={downloadPage()} data-download>
          <Glyph name="frame-solid" size={20} />
          <span data-download-label>Download FramePort</span>
        </a>
        <a class="btn btn-secondary" href="#tour"><Glyph name="frame" size={20} /> Try the app</a>
      </div>
      <ul class="platforms" aria-label="All downloads">
        {DOWNLOADS.map((d) => (
          <li><a href={downloadPage(d.os)} data-os={d.os}>{d.label}</a></li>
        ))}
        <li><a href={RELEASES}>All releases</a></li>
      </ul>
      <p class="facts">Free and open source · GPL-3.0 · Wi-Fi or USB cable · Not affiliated with Valve or Meta</p>
    </div>
    <div class="scene">
      <Crossing games={games} />
    </div>
  </div>
</section>

<style>
  .hero { position: relative; overflow: hidden; padding-block: clamp(48px, 8vw, 104px) clamp(56px, 8vw, 96px);
    background: var(--portal-glow); }
  .hero-in { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr); gap: clamp(24px, 4vw, 64px);
    align-items: center; }
  h1 { font-size: clamp(42px, 6.4vw, 76px); line-height: 1.0; font-weight: 800; letter-spacing: -0.035em; }
  h1 .q { color: var(--secondary); }
  h1 .f { color: var(--accent); }
  .lead { margin-top: 24px; }
  .ctas { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 32px; }
  .platforms { list-style: none; display: flex; flex-wrap: wrap; gap: 4px 16px; padding: 0; margin: 18px 0 0;
    font: 500 13px/20px var(--font-sans); }
  .platforms a { display: inline-block; padding-block: 10px; margin-block: -10px; color: var(--text-2); text-decoration: none; }
  .platforms a:hover { color: var(--text); text-decoration: underline; }
  .platforms a[aria-current] { color: var(--accent); }
  .facts { margin-top: 28px; padding-top: 16px; border-top: 1px solid var(--border); font: 400 12px/1.6 var(--font-mono);
    color: var(--text-2); letter-spacing: .02em; }
  .scene { position: relative; }
  @media (max-width: 900px) {
    .hero-in { grid-template-columns: 1fr; }
    .scene { max-width: 560px; width: 100%; margin-inline: auto; }
  }
</style>
