---
// The home page's look at the latest release (src/data/releases.ts): its first changes, the few releases before it
// and the dev build in testing. The full list is the changelog page.
import { LATEST, NEXT, RELEASES } from '../data/releases';
import { url } from '../data/site';

const before = RELEASES.slice(1, 4);
const page = (v?: string) => url(`changelog/${v ? `#v${v.replaceAll('.', '-')}` : ''}`);
const more = LATEST ? LATEST.changes - LATEST.highlights.length : 0;
---
{LATEST && (
  <section class="section" id="whats-new">
    <div class="wrap">
      <div class="head reveal">
        <p class="label"><b>06</b> What's new</p>
        <h2>FramePort {LATEST.version}</h2>
      </div>

      <div class="wn reveal">
        <a class="now" href={page(LATEST.version)}>
          <span class="top"><span class="pill pill-ok">Latest</span><time datetime={LATEST.date}>{LATEST.date}</time></span>
          <ul>{LATEST.highlights.map((h) => <li>{h}</li>)}</ul>
          <span class="more">{more > 0 ? `${more} more ${more === 1 ? 'change' : 'changes'}` : 'Read the release'} →</span>
        </a>

        <div class="side">
          <ol class="mini">
            {before.map((r) => (
              <li class={r.kind}>
                <a href={page(r.version)}>
                  <span class="v">{r.version}</span>
                  <time datetime={r.date}>{r.date}</time>
                  <span class="h">{r.highlights[0] ?? ''}</span>
                </a>
              </li>
            ))}
          </ol>
          {NEXT && (
            <a class="soon" href={url('changelog/#next')}>
              <span class="pill pill-pc">In testing</span>
              <span>Coming next: <b>{NEXT.version}</b></span>
            </a>
          )}
          <a class="btn btn-secondary btn-small all" href={page()}>All releases</a>
        </div>
      </div>
    </div>
  </section>
)}

<style>
  .wn { display: grid; grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr); gap: 16px; }
  .now { position: relative; display: grid; gap: 16px; align-content: start; padding: clamp(20px, 3vw, 30px); border-radius: var(--radius-md);
    background: var(--surface); border: 1px solid var(--border); color: var(--text-2); text-decoration: none; overflow: hidden;
    transition: border-color 250ms, transform 300ms var(--ease-out); }
  .now::before { content: ""; position: absolute; inset: 0 0 auto; height: 2px; background: var(--portal); }
  .now::after { content: ""; position: absolute; width: 420px; height: 420px; right: -200px; top: -230px; pointer-events: none;
    background: radial-gradient(closest-side, rgba(255, 138, 31, .12), rgba(58, 168, 255, .05) 55%, transparent); }
  .now:hover { border-color: var(--border-strong); transform: translateY(-2px); text-decoration: none; }
  .top { display: flex; align-items: center; gap: 12px; }
  .top time, .mini time { font: 400 12.5px var(--font-mono); color: var(--text-3); }
  .now ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
  .now li { position: relative; padding-left: 22px; line-height: 1.5; }
  .now li::before { content: ""; position: absolute; left: 3px; top: .6em; width: 8px; height: 8px; border-radius: 2px;
    background: var(--portal); transform: rotate(45deg); }
  .more { font-weight: 600; color: var(--accent); }

  .side { display: grid; gap: 12px; align-content: start; }
  .mini { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
  .mini a { display: grid; grid-template-columns: auto 1fr; gap: 2px 12px; padding: 12px 16px; border-radius: var(--radius-md);
    border: 1px solid var(--border); background: rgba(22, 24, 30, .6); text-decoration: none; transition: border-color 200ms; }
  .mini a:hover { border-color: var(--border-strong); text-decoration: none; }
  .mini .v { font: 700 16px/1.3 var(--font-display); color: var(--text); }
  .mini .feature .v { background: var(--portal); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .mini time { justify-self: end; align-self: center; }
  .mini .h { grid-column: 1 / -1; color: var(--text-2); font-size: 14px; line-height: 1.45;
    display: -webkit-box; -webkit-line-clamp: 1; line-clamp: 1; -webkit-box-orient: vertical; overflow: hidden; }
  .soon { display: flex; align-items: center; gap: 10px; padding: 10px 14px; border-radius: var(--radius-md);
    border: 1px dashed var(--secondary-line); color: var(--text-2); font-size: 14px; text-decoration: none; }
  .soon b { color: var(--text); font: 500 13px var(--font-mono); }
  .soon:hover { background: rgba(58, 168, 255, .06); text-decoration: none; }
  .all { justify-self: start; }
  @media (max-width: 860px) { .wn { grid-template-columns: 1fr; } }
  @media (prefers-reduced-motion: reduce) { .now { transition: none; } .now:hover { transform: none; } }
</style>
