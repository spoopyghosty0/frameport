---
// One of the app's 24 px line glyphs (src/frameport/ui/icons/glyphs), inlined so it takes the text colour.
import { readFileSync } from 'node:fs';
import { join } from 'node:path';

interface Props {
  name: 'frame' | 'frame-solid' | 'pc' | 'port' | 'patch' | 'container' | 'test' | 'sync' | 'live' | 'shot' | 'keys'
    | 'recipe' | 'link';
  size?: number;
  class?: string;
}
const { name, size = 20, class: cls = '' } = Astro.props;
const raw = readFileSync(join(process.cwd(), '..', 'src/frameport/ui/icons/glyphs', `${name}.svg`), 'utf8');
const svg = raw
  .replaceAll('#FFFFFF', 'currentColor')
  .replace(/ width="24" height="24"/, ` width="${size}" height="${size}" class="glyph ${cls}" aria-hidden="true" focusable="false"`);
---
<Fragment set:html={svg} />
