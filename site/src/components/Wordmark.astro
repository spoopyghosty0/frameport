---
// The wordmark as the app draws it (components.wordmark + glyphs.portal_mark): "Frame" orange, the small tilted
// portal (rim from orange to blue around a dark hole), "Port" blue.
interface Props { id: string; href?: string; class?: string }
const { id, href, class: cls = '' } = Astro.props;
const Tag = href ? 'a' : 'span';
---
<Tag class={`wordmark ${cls}`} href={href} aria-label="FramePort">
  <span class="f" aria-hidden="true">Frame</span>
  <svg viewBox="0 0 16 28" aria-hidden="true">
    <defs>
      <linearGradient id={`wm-${id}`} gradientUnits="userSpaceOnUse" x1="2" y1="0" x2="14" y2="0">
        <stop offset=".3" stop-color="#FF8A1F" /><stop offset=".7" stop-color="#3AA8FF" />
      </linearGradient>
    </defs>
    <ellipse cx="8" cy="14" rx="4.4" ry="10.6" transform="rotate(14 8 14)" fill="none" stroke={`url(#wm-${id})`}
      stroke-opacity=".35" stroke-width="5" />
    <ellipse cx="8" cy="14" rx="4.4" ry="10.6" transform="rotate(14 8 14)" fill="#0D0E12" stroke={`url(#wm-${id})`}
      stroke-width="2.6" />
  </svg>
  <span class="p" aria-hidden="true">Port</span>
</Tag>
