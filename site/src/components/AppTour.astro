---
// The app itself: a clickable copy (AppMock) with a guided tour, the showcase videos (rendered by scripts/showcase,
// never by hand) in a player, and real screenshots.
import { Image } from 'astro:assets';
import AppMock from './AppMock.astro';
import Glyph from './Glyph.astro';
import type { MockGame } from '../scripts/mock';
import { url } from '../data/site';
import library from '../assets/media/library.png';
import game from '../assets/media/game.png';
import monitor from '../assets/media/monitor.png';
import live from '../assets/media/live-view.png';
import files from '../assets/media/files.png';
import keys from '../assets/media/type-on-frame.png';
import screenshots from '../assets/media/screenshots.png';

interface Props { games: MockGame[] }
const { games } = Astro.props;
const shots = [
  { img: library, title: 'Library', text: 'Your games with their artwork. Search, tags and filters; install several at once.' },
  { img: game, title: 'Game page', text: 'One click to install or play. Patches and game settings under Customize.' },
  { img: monitor, title: 'Monitor', text: "The game's frame rate, the Frame's load, temperatures, power and battery, live." },
  { img: live, title: 'Live view', text: 'What the headset shows, with sound, in a browser window on your computer.' },
  { img: screenshots, title: 'Screenshots', text: 'The pictures you took in the headset, sorted by game and day.' },
  { img: files, title: 'Files', text: "The Frame's videos, downloads and each game's storage. Drag and drop." },
  { img: keys, title: 'Type on Frame', text: "Your computer's keyboard, typing in VR apps, Steam and the desktop." },
];
const videos = [
  { id: 'tour', title: 'The tour', text: 'Library, install, play, monitor · about 90 s' },
  { id: 'install', title: 'The install tutorial', text: 'From the download to the first game · about 80 s' },
];
---
<section class="section tour" id="tour">
  <div class="wrap">
    <div class="head reveal">
      <p class="label"><b>02</b> The app</p>
      <h2>Try it before you download it.</h2>
      <p class="lead">A working copy of FramePort's window, simplified, with a pretend Frame. Take the guided tour from a
        fresh start, or click around a set-up library: install a game, start it, watch the monitor, type on the Frame.</p>
    </div>

    <div class="reveal"><AppMock games={games} /></div>

    <div class="watch reveal">
      <p class="watch-k">Prefer to watch? The real app, filmed at 1440p</p>
      <div class="vids">
        {videos.map((v) => (
          <button type="button" class="vid" data-video={v.id}>
            <img src={url(`media/frameport-${v.id}.jpg`)} alt="" width="1280" height="720" loading="lazy" decoding="async" />
            <span class="vid-play" aria-hidden="true"><svg viewBox="0 0 24 24" width="22" height="22"><path d="M8 5.5v13l11-6.5z" fill="currentColor" /></svg></span>
            <span class="vid-t"><b>{v.title}</b><span>{v.text}</span></span>
          </button>
        ))}
      </div>
    </div>
  </div>

  <div class="strip-wrap reveal">
    <ul class="strip" tabindex="0" aria-label="Screenshots">
      {shots.map((s) => (
        <li>
          <figure class="shot">
            <a class="shot-img" href={s.img.src}>
              <Image src={s.img} alt={`FramePort ${s.title}`} widths={[480, 800, 1200]} sizes="(max-width: 700px) 82vw, 560px" />
            </a>
            <figcaption><strong>{s.title}</strong> {s.text}</figcaption>
          </figure>
        </li>
      ))}
    </ul>
    <p class="strip-hint wrap"><Glyph name="shot" size={16} /> Screenshots of the real app · scroll sideways for more</p>
  </div>

  <dialog class="player" data-player aria-label="Video">
    <video controls playsinline preload="none" data-player-video></video>
    <form method="dialog"><button class="close" aria-label="Close">×</button></form>
  </dialog>
</section>

<script>
  import { url } from '../data/site';
  const dlg = document.querySelector<HTMLDialogElement>('[data-player]');
  const video = document.querySelector<HTMLVideoElement>('[data-player-video]');
  document.querySelectorAll<HTMLButtonElement>('[data-video]').forEach((b) => b.addEventListener('click', () => {
    if (!dlg || !video) return;
    video.poster = url(`media/frameport-${b.dataset.video}.jpg`);
    video.src = url(`media/frameport-${b.dataset.video}.mp4`);
    dlg.showModal();
    video.play().catch(() => {});
  }));
  dlg?.addEventListener('close', () => { video?.pause(); });
  dlg?.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
</script>

<style>
  .tour { background: linear-gradient(180deg, transparent, rgba(17, 18, 23, 0.7) 20%, rgba(17, 18, 23, 0.7) 85%, transparent); }
  .watch { margin-top: 36px; display: grid; gap: 14px; }
  .watch-k { font: 600 12px/1 var(--font-mono); letter-spacing: .12em; text-transform: uppercase; color: var(--text-2); }
  .vids { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 16px; }
  .vid { all: unset; position: relative; display: grid; grid-template-columns: auto 1fr; align-items: center; gap: 12px 14px;
    cursor: pointer; transition: transform 220ms var(--ease-out); }
  .vid img { grid-column: 1 / -1; width: 100%; height: auto; aspect-ratio: 16 / 9; object-fit: cover; opacity: .9;
    border-radius: var(--radius-md); border: 1px solid var(--border); box-shadow: var(--shadow-art);
    transition: opacity 220ms, box-shadow 220ms var(--ease-out); }
  .vid:hover img { box-shadow: var(--shadow-art-hover); }
  .vid:hover, .vid:focus-visible { transform: translateY(-3px); }
  .vid:hover img { opacity: 1; }
  .vid:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
  .vid-play { position: relative; width: 46px; height: 46px; border-radius: 50%; display: grid; place-items: center;
    background: rgba(22, 24, 30, .65); backdrop-filter: blur(8px); border: 1px solid rgba(237, 238, 242, .25); color: var(--text);
    transition: background-color 220ms, color 220ms, box-shadow 220ms; }
  .vid-play svg { margin-left: 3px; }
  .vid:hover .vid-play { background: var(--accent); color: var(--on-accent); box-shadow: 0 0 26px rgba(255, 138, 31, .55); }
  .vid-t { display: grid; gap: 2px; }
  .vid-t b { font: 700 16px/1.2 var(--font-display); }
  .vid-t span { font-size: 13px; color: var(--text-2); }

  .player { padding: 0; border: 1px solid var(--border-strong); border-radius: var(--radius-md); background: #000; width: min(1280px, 94vw);
    max-height: 92vh; overflow: hidden; }
  .player::backdrop { background: rgba(5, 6, 8, .85); backdrop-filter: blur(4px); }
  .player video { display: block; width: 100%; height: auto; max-height: 90vh; background: #000; }
  .player .close { all: unset; position: absolute; right: 10px; top: 8px; width: 36px; height: 36px; border-radius: 50%; display: grid;
    place-items: center; font-size: 24px; color: var(--text); background: rgba(22, 24, 30, .7); cursor: pointer; }
  .player .close:hover { background: var(--accent); color: var(--on-accent); }

  .strip-wrap { margin-top: clamp(48px, 7vw, 72px); }
  .strip { list-style: none; margin: 0; display: flex; gap: 20px; overflow-x: auto; scroll-snap-type: x mandatory;
    padding: 12px max(var(--gutter), calc((100vw - var(--page)) / 2)) 28px; scroll-padding-inline: max(var(--gutter), calc((100vw - var(--page)) / 2));
    scrollbar-width: thin; scrollbar-color: var(--border-strong) transparent; }
  .strip li { flex: 0 0 min(82vw, 560px); scroll-snap-align: start; }
  .shot { margin: 0; }
  .shot-img { display: block; border-radius: var(--radius-md); overflow: hidden; border: 1px solid var(--border);
    box-shadow: var(--shadow-art); background: var(--surface);
    transition: transform 220ms var(--ease-out), box-shadow 220ms var(--ease-out), border-color 220ms; }
  .shot-img :global(img) { width: 100%; height: auto; aspect-ratio: 16 / 10; object-fit: cover; object-position: top left;
    transition: transform 600ms var(--ease-out); }
  .shot-img:hover { transform: translateY(-4px); box-shadow: var(--shadow-art-hover); border-color: rgba(255, 138, 31, 0.4); }
  .shot-img:hover :global(img) { transform: scale(1.03); }
  figcaption { margin-top: 14px; color: var(--text-2); font-size: 14px; line-height: 1.55; }
  figcaption strong { color: var(--text); font-weight: 600; margin-right: 4px; }
  .strip-hint { display: flex; align-items: center; gap: 8px; color: var(--text-2); font: 400 12px/1 var(--font-mono); }
</style>
