---
// The app itself: the showcase tour (rendered in CI from the demo library, never by hand) and real screenshots.
import { Image } from 'astro:assets';
import Glyph from './Glyph.astro';
import { url } from '../data/site';
import library from '../assets/media/library.png';
import game from '../assets/media/game.png';
import monitor from '../assets/media/monitor.png';
import live from '../assets/media/live-view.png';
import files from '../assets/media/files.png';
import keys from '../assets/media/type-on-frame.png';
import screenshots from '../assets/media/screenshots.png';

const shots = [
  { img: library, title: 'Library', text: 'Your games with their artwork. Search, tags and filters; install several at once.' },
  { img: game, title: 'Game page', text: 'One click to install or play. Patches and game settings under Customize.' },
  { img: monitor, title: 'Monitor', text: "The game's frame rate, the Frame's load, temperatures, power and battery, live." },
  { img: live, title: 'Live view', text: 'What the headset shows, with sound, in a browser window on your computer.' },
  { img: screenshots, title: 'Screenshots', text: 'The pictures you took in the headset, sorted by game and day.' },
  { img: files, title: 'Files', text: "The Frame's videos, downloads and each game's storage. Drag and drop." },
  { img: keys, title: 'Type on Frame', text: "Your computer's keyboard, typing in VR apps, Steam and the desktop." },
];
---
<section class="section tour" id="tour">
  <div class="wrap">
    <div class="head reveal">
      <p class="label"><b>02</b> The app</p>
      <h2>A library for the Frame,<br />on your computer.</h2>
      <p class="lead">Windows, macOS and Linux. It finds your Frame on the network, keeps itself up to date and shows what
        the headset is doing while you play.</p>
    </div>

    <figure class="screen reveal">
      <div class="screen-bar" aria-hidden="true">
        <span class="dot"></span><span class="screen-name">FramePort</span>
        <span class="screen-note">90 s tour · demo library</span>
      </div>
      <button class="play" type="button" data-play aria-label="Play the 90-second tour video">
        <img src={url('media/tour-teaser.webp')} alt="FramePort's library, a game being installed and played, the monitor"
          width="960" height="540" loading="lazy" decoding="async" />
        <span class="play-btn" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="26" height="26"><path d="M8 5.5v13l11-6.5z" fill="currentColor" /></svg>
        </span>
      </button>
      <template data-video>
        <video controls autoplay playsinline preload="metadata" poster={url('media/frameport-tour.jpg')}
          src={url('media/frameport-tour.mp4')} width="1280" height="720"></video>
      </template>
    </figure>
    <p class="after reveal">
      <a href={url('media/frameport-tour.mp4')}>Download the tour (MP4)</a>
      <span aria-hidden="true">·</span>
      <a href="#install">The install tutorial</a>
    </p>
  </div>

  <div class="strip-wrap reveal">
    <ul class="strip" tabindex="0" aria-label="Screenshots">
      {shots.map((s) => (
        <li>
          <figure class="shot">
            <a class="shot-img" href={s.img.src}>
              <Image src={s.img} alt={`FramePort ${s.title}`} widths={[480, 800, 1200]} sizes="(max-width: 700px) 82vw, 560px" />
            </a>
            <figcaption><strong>{s.title}</strong> {s.text}</figcaption>
          </figure>
        </li>
      ))}
    </ul>
    <p class="strip-hint wrap"><Glyph name="shot" size={16} /> Scroll sideways for more · every screenshot is rendered from a demo library</p>
  </div>
</section>

<script>
  // The teaser loops silently; a click swaps in the full tour with sound and controls.
  const btn = document.querySelector<HTMLButtonElement>('[data-play]');
  const tpl = document.querySelector<HTMLTemplateElement>('[data-video]');
  btn?.addEventListener('click', () => {
    if (!tpl) return;
    const video = tpl.content.firstElementChild!.cloneNode(true) as HTMLVideoElement;
    btn.replaceWith(video);
    video.focus();
  });
</script>

<style>
  .tour { background: linear-gradient(180deg, transparent, rgba(17, 18, 23, 0.7) 30%, rgba(17, 18, 23, 0.7) 80%, transparent); }
  .screen { margin: 0; border-radius: var(--radius-md); overflow: hidden; border: 1px solid var(--border-strong);
    background: var(--sidebar); box-shadow: 0 30px 80px -20px rgba(0, 0, 0, 0.8), 0 0 0 1px rgba(0, 0, 0, 0.4); }
  .screen-bar { position: relative; display: flex; align-items: center; gap: 10px; padding: 10px 16px; font: 500 12px/1 var(--font-sans);
    color: var(--text-2); border-bottom: 1px solid var(--border); }
  .screen-bar::after { content: ""; position: absolute; left: 0; right: 0; bottom: -1px; height: 1px; background: var(--portal); opacity: .6; }
  .dot { width: 8px; height: 8px; border-radius: 50%; background: var(--ok); box-shadow: 0 0 10px rgba(61, 214, 140, 0.6); }
  .screen-name { color: var(--text); font-weight: 600; }
  .screen-note { margin-left: auto; font-family: var(--font-mono); }
  .play { position: relative; display: block; width: 100%; padding: 0; border: 0; background: #000; cursor: pointer; }
  .play img { width: 100%; height: auto; aspect-ratio: 16 / 9; object-fit: cover; }
  .play-btn { position: absolute; left: 50%; top: 50%; width: 76px; height: 76px; margin: -38px 0 0 -38px; border-radius: 50%;
    display: grid; place-items: center; color: var(--text);
    background: rgba(22, 24, 30, 0.6); -webkit-backdrop-filter: blur(8px); backdrop-filter: blur(8px);
    border: 1px solid rgba(237, 238, 242, 0.25); box-shadow: 0 6px 22px rgba(0, 0, 0, 0.55);
    transition: background-color 220ms var(--ease-out), box-shadow 220ms var(--ease-out), transform 320ms var(--ease-back), color 220ms; }
  .play-btn svg { margin-left: 4px; }
  .play:hover .play-btn, .play:focus-visible .play-btn { background: var(--accent); color: var(--on-accent); transform: scale(1.08);
    box-shadow: 0 0 26px 1px rgba(255, 138, 31, 0.55), 0 6px 18px rgba(0, 0, 0, 0.5); }
  .screen :global(video) { display: block; width: 100%; height: auto; aspect-ratio: 16 / 9; background: #000; }
  .after { margin-top: 16px; display: flex; gap: 10px; font-size: 14px; color: var(--text-3); }

  .strip-wrap { margin-top: clamp(48px, 7vw, 80px); }
  .strip { list-style: none; margin: 0; display: flex; gap: 20px; overflow-x: auto; scroll-snap-type: x mandatory;
    padding: 12px max(var(--gutter), calc((100vw - var(--page)) / 2)) 28px; scroll-padding-inline: max(var(--gutter), calc((100vw - var(--page)) / 2));
    scrollbar-width: thin; scrollbar-color: var(--border-strong) transparent; }
  .strip li { flex: 0 0 min(82vw, 560px); scroll-snap-align: start; }
  .shot { margin: 0; }
  .shot-img { display: block; border-radius: var(--radius-md); overflow: hidden; border: 1px solid var(--border);
    box-shadow: var(--shadow-art); background: var(--surface);
    transition: transform 220ms var(--ease-out), box-shadow 220ms var(--ease-out), border-color 220ms; }
  .shot-img :global(img) { width: 100%; height: auto; aspect-ratio: 16 / 10; object-fit: cover; object-position: top left;
    transition: transform 600ms var(--ease-out); }
  .shot-img:hover { transform: translateY(-4px); box-shadow: var(--shadow-art-hover); border-color: rgba(255, 138, 31, 0.4); }
  .shot-img:hover :global(img) { transform: scale(1.03); }
  figcaption { margin-top: 14px; color: var(--text-2); font-size: 14px; line-height: 1.55; }
  figcaption strong { color: var(--text); font-weight: 600; margin-right: 4px; }
  .strip-hint { display: flex; align-items: center; gap: 8px; color: var(--text-3); font: 400 12px/1 var(--font-mono); }
</style>
