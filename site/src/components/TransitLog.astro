---
// How it works, as the install log of one real catalog game: the stages on the PC in blue, the ones on the Frame in
// orange, the portal between them.
import Glyph from './Glyph.astro';
import PcvrHow from './PcvrHow.astro';
import { patchLabel, stageDetails, type LogGame } from '../scripts/logdetails';

interface Props { example: LogGame; others: LogGame[] }
const { example, others } = Astro.props;
const d = stageDetails(example);

type Stage = { glyph: Parameters<typeof Glyph>[0]['name']; name: string; detail: string; text: string };
const pc: Stage[] = [
  { glyph: 'pc', name: 'scan', detail: d.scan,
    text: 'Point FramePort at a folder. It finds Quest games, PC VR games, Android apps and Linux apps.' },
  { glyph: 'container', name: 'analyze', detail: d.analyze,
    text: 'Checks what the game is built with, without running it.' },
  { glyph: 'recipe', name: 'recipe', detail: d.recipe,
    text: 'Picks the tested recipe (the patches a game needs), or suggests patches for an untested game.' },
  { glyph: 'port', name: 'convert', detail: d.convert,
    text: "OVRPort rewrites the game's Meta VR code for the Frame." },
  { glyph: 'patch', name: 'patch', detail: d.patch,
    text: 'Patches fill in what the Frame lacks, such as passthrough and 360° screens.' },
  { glyph: 'keys', name: 'sign', detail: d.sign,
    text: 'Each game keeps its own key, so updates keep your saves.' },
  { glyph: 'test', name: 'check', detail: d.check,
    text: "Problems that would stop the game are reported before the upload." },
];
const frame: Stage[] = [
  { glyph: 'sync', name: 'upload', detail: d.upload,
    text: 'Over Wi-Fi or a USB cable. A stopped upload continues where it left off.' },
  { glyph: 'frame', name: 'library', detail: d.library,
    text: 'The game shows up in your Steam library with its artwork. Start it like any other game.' },
  { glyph: 'live', name: 'test', detail: d.test,
    text: "A launch test starts the game and, if it fails, names the likely patch." },
];
---
<section class="section" id="how">
  <div class="wrap">
    <div class="head reveal">
      <p class="label"><b>01</b> How it works</p>
      <h2>Ten stages between your PC and the Steam Frame<br /><span class="muted">You click once</span></h2>
    </div>

    <div class="log reveal" data-log>
      <div class="log-bar">
        <span class="log-title"><Glyph name="frame" size={18} /><span>Installing <b data-lg="title">{example.title}</b> on the Frame</span></span>
        <span class="log-progress" aria-hidden="true"><i></i></span>
      </div>

      <p class="side side-pc"><Glyph name="pc" size={16} /> On your PC</p>
      <ol class="stages">
        {pc.map((s, i) => (
          <li class="stage pc" style={`--i:${i}`}>
            <span class="g"><Glyph name={s.glyph} size={20} /></span>
            <code class="n">{s.name}</code>
            <p class="t">{s.text}</p>
            <code class="d" data-lg={s.name}>{s.detail}</code>
            <span class="ok" aria-label="done">ok</span>
          </li>
        ))}
      </ol>

      <div class="seam" aria-hidden="true"><span>through the portal</span></div>

      <p class="side side-frame"><Glyph name="frame" size={16} /> On the Frame</p>
      <ol class="stages" start={8}>
        {frame.map((s, i) => (
          <li class="stage frame" style={`--i:${i + 7}`}>
            <span class="g"><Glyph name={s.glyph} size={20} /></span>
            <code class="n">{s.name}</code>
            <p class="t">{s.text}</p>
            <code class="d" data-lg={s.name}>{s.detail}</code>
            <span class="ok" aria-label="done">ok</span>
          </li>
        ))}
      </ol>
    </div>
    <p class="foot muted reveal">
      <span class="recipe-box" aria-live="polite">
        <span class="rb-k">Recipe</span>
        <span class="rb-p" data-lg-patches>{example.patches.length ? example.patches.map((x) => <code>{patchLabel(x)}</code>) : <code>Default patches</code>}</span>
        <span class="rb-n" data-lg-note>{example.note}</span>
      </span>
      <span class="foot-t"><span data-lg="foot">{example.title}</span>'s recipe from the catalog. Untested games get suggested patches.</span>
      <button type="button" class="btn btn-secondary btn-small again" data-again>↻ Try another game</button>
    </p>
    <PcvrHow />
  </div>
</section>

<script type="application/json" data-log-games set:html={JSON.stringify(others).replaceAll('<', '\\u003c')} />

<script>
  import { patchLabel, stageDetails, type LogGame } from '../scripts/logdetails';
  // another tested game, its real engine, VR API and recipe; the log plays again
  const log = document.querySelector<HTMLElement>('[data-log]');
  const games = JSON.parse(document.querySelector('[data-log-games]')?.textContent || '[]') as
    LogGame[];
  let last = -1;
  document.querySelector('[data-again]')?.addEventListener('click', () => {
    if (!log || !games.length) return;
    let k = Math.floor(Math.random() * games.length);
    if (k === last) k = (k + 1) % games.length;
    last = k;
    const g = games[k];
    const set = (key: string, v: string) => document.querySelectorAll(`[data-lg="${key}"]`).forEach((el) => { el.textContent = v; });
    set('title', g.title); set('foot', g.title);
    for (const [k, v] of Object.entries(stageDetails(g))) set(k, v);
    const chips = document.querySelector('[data-lg-patches]');
    if (chips) {
      chips.replaceChildren(...(g.patches.length ? g.patches : ['Default patches']).map((x) => {
        const c = document.createElement('code');
        c.textContent = g.patches.length ? patchLabel(x) : x;
        return c;
      }));
    }
    const note = document.querySelector('[data-lg-note]');
    if (note) note.textContent = g.note;
    log.classList.remove('sweep');
    void log.offsetWidth;  // restart the sweep
    log.classList.add('sweep');
  });
</script>

<style>
  .log { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-md); overflow: hidden; }
  .log-bar { display: flex; align-items: center; gap: 16px; padding: 14px 20px; background: var(--sidebar);
    border-bottom: 1px solid var(--border); }
  .log-title { display: inline-flex; align-items: center; gap: 10px; font: 600 14px/20px var(--font-sans); }
  .log-title .glyph { color: var(--accent); }
  .log-progress { margin-left: auto; width: min(220px, 30%); height: 4px; border-radius: 4px; background: var(--surface-3);
    overflow: hidden; }
  .log-progress i { display: block; height: 100%; width: 100%; background: var(--portal); transform-origin: left;
    transform: scaleX(1); }
  .log.scrubbed .log-progress i { transform: scaleX(0); transition: transform 450ms var(--ease-out); }

  .side { display: flex; align-items: center; gap: 8px; padding: 18px 20px 6px; margin: 0;
    font: 600 11px/1 var(--font-mono); letter-spacing: .14em; text-transform: uppercase; }
  .side-pc { color: var(--secondary); }
  .side-frame { color: var(--accent); }

  .stages { list-style: none; margin: 0; padding: 0 8px 8px; }
  .stage { display: grid; grid-template-columns: 36px 92px minmax(0, 1fr) minmax(0, 250px) 28px; gap: 4px 14px;
    align-items: baseline; padding: 12px; border-radius: var(--radius-sm); }
  .stage + .stage { border-top: 1px solid rgba(42, 45, 55, 0.6); }
  .stage:hover { background: rgba(237, 238, 242, 0.03); }
  .g { align-self: center; width: 32px; height: 32px; border-radius: 50%; display: grid; place-items: center; }
  .pc .g { color: var(--secondary); background: rgba(58, 168, 255, 0.12); }
  .frame .g { color: var(--accent); background: rgba(255, 138, 31, 0.12); }
  .n { font-size: 14px; font-weight: 600; }
  .pc .n { color: var(--secondary); }
  .frame .n { color: var(--accent); }
  .t { color: var(--text-2); font-size: 15px; line-height: 1.55; }
  .d { color: var(--text-2); font-size: 12.5px; text-align: right; overflow-wrap: anywhere; }
  .ok { font: 600 11px/1 var(--font-mono); color: var(--ok); text-transform: uppercase; justify-self: end; }

  /* scrolling completes the install line by line (scripts/interactions.ts marks .done), like the app's activity log */
  .log.scrubbed .stage { opacity: .32; transition: opacity 450ms var(--ease-out), background-color 300ms; }
  .log.scrubbed .stage.done { opacity: 1; }
  .log.scrubbed .stage.done .g { animation: gpop .5s var(--ease-back); }
  .log.scrubbed .ok { opacity: 0; transform: scale(.5); transition: opacity 300ms, transform 400ms var(--ease-back); }
  .log.scrubbed .stage.done .ok { opacity: 1; transform: none; }
  .log.complete .log-title::after { content: "· done"; margin-left: 4px; color: var(--ok); font: 600 12px/1 var(--font-mono); }
  @keyframes gpop { 40% { transform: scale(1.25); } }
  /* another game: a light sweeps down the lines */
  .log.sweep .stage { animation: sweep .7s var(--ease-out) both; animation-delay: calc(var(--i) * 70ms); }
  @keyframes sweep { 0% { background-color: rgba(255, 138, 31, 0); } 30% { background-color: rgba(255, 138, 31, .1); } 100% { background-color: rgba(255, 138, 31, 0); } }

  .seam { position: relative; height: 40px; margin: 6px 0; display: grid; place-items: center; }
  .seam::before { content: ""; position: absolute; left: 20px; right: 20px; top: 50%; height: 2px; background: var(--portal);
    opacity: .7; }
  .seam span { position: relative; padding: 4px 12px; background: var(--surface); font: 500 12px/1 var(--font-mono);
    color: var(--text-2); letter-spacing: .06em; }

  .foot { margin-top: 18px; font-size: 14px; display: flex; flex-wrap: wrap; align-items: center; gap: 10px 16px; }
  .recipe-box { flex-basis: 100%; display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 6px 14px; align-items: baseline;
    padding: 14px 16px; border-radius: var(--radius-sm); background: var(--surface); border: 1px solid var(--border); }
  .rb-k { font: 600 11px/1 var(--font-mono); letter-spacing: .12em; text-transform: uppercase; color: var(--accent); }
  .rb-p { display: flex; flex-wrap: wrap; gap: 6px; }
  .rb-p code { font-size: 12px; padding: 3px 8px; border-radius: 6px; background: rgba(58, 168, 255, .1); color: var(--secondary);
    animation: chip .35s var(--ease-out) both; }
  .rb-n { grid-column: 2; color: var(--text-2); font-size: 14px; }
  .rb-n:empty { display: none; }
  @keyframes chip { from { opacity: 0; transform: translateY(4px); } }
  .again { font-size: 13px; }

  @media (max-width: 860px) {
    .stage { grid-template-columns: 36px minmax(0, 1fr) auto; }
    .g { grid-row: span 3; align-self: start; }
    .n { grid-column: 2; }
    .ok { grid-column: 3; grid-row: 1; }
    .t { grid-column: 2 / 4; }
    .d { grid-column: 2 / 4; text-align: left; }
  }
</style>
