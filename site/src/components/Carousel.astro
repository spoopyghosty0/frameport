---
// The app's screens as a carousel of live, clickable copies (AppMock compact): not pictures. Arrows, keys, chapter
// tabs, autoplay that stops as soon as you touch a screen.
import AppMock from './AppMock.astro';
import type { MockGame, Route } from '../scripts/mock';

interface Slide { route: Route; title: string; text: string; live?: boolean }
interface Props { slides: Slide[]; games: MockGame[] }
const { slides, games } = Astro.props;
---
<div class="car" data-car tabindex="0" role="region" aria-roledescription="carousel" aria-label="FramePort's screens, live">
  <div class="stage" data-car-stage>
    {slides.map((s, i) => (
      <section class:list={['slide', { on: i === 0 }]} data-slide={i} aria-roledescription="slide"
        aria-label={`${i + 1} of ${slides.length}: ${s.title}`} inert={i !== 0 ? true : undefined}>
        <AppMock games={games} compact route={s.route} live={s.live} />
      </section>
    ))}
    <span class="livetag" aria-hidden="true"><i></i> live · click around</span>
    <button type="button" class="nav prev" data-prev aria-label="Previous screen">
      <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m15 5-7 7 7 7" /></svg>
    </button>
    <button type="button" class="nav next" data-next aria-label="Next screen">
      <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m9 5 7 7-7 7" /></svg>
    </button>
  </div>
  <div class="cap">
    <p class="ct" aria-live="polite"><b data-ct>{slides[0].title}</b> <span data-cx>{slides[0].text}</span></p>
    <span class="count"><span data-cn>1</span> / {slides.length}</span>
    <button type="button" class="pp" data-pp aria-label="Pause the slideshow" aria-pressed="false">
      <svg class="i-pause" viewBox="0 0 24 24" width="16" height="16"><path d="M7 5h3v14H7zM14 5h3v14h-3z" fill="currentColor" /></svg>
      <svg class="i-play" viewBox="0 0 24 24" width="16" height="16"><path d="M8 5.5v13l11-6.5z" fill="currentColor" /></svg>
    </button>
  </div>
  <ol class="tabs">
    {slides.map((s, i) => (
      <li>
        <button type="button" class:list={['tab', { on: i === 0 }]} data-thumb={i} aria-current={i === 0 ? 'true' : undefined}>
          <span class="tl">{s.title}</span>
          <span class="bar"><i></i></span>
        </button>
      </li>
    ))}
  </ol>
  <script type="application/json" data-car-text set:html={JSON.stringify(slides.map((s) => [s.title, s.text])).replaceAll('<', '\\u003c')} />
</div>

<script>
  const car = document.querySelector<HTMLElement>('[data-car]');
  if (car) {
    const slides = [...car.querySelectorAll<HTMLElement>('[data-slide]')];
    const tabs = [...car.querySelectorAll<HTMLButtonElement>('[data-thumb]')];
    const text = JSON.parse(car.querySelector('[data-car-text]')?.textContent || '[]') as [string, string][];
    const pp = car.querySelector<HTMLButtonElement>('[data-pp]')!;
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const DWELL = 6500;
    let i = 0, paused = reduce, hover = false, visible = false, elapsed = 0;

    const go = (n: number, dir = n > i ? 1 : -1) => {
      const next = (n + slides.length) % slides.length;
      if (next === i) return;
      car.style.setProperty('--dir', String(dir));
      slides[i].classList.remove('on'); slides[i].inert = true;
      tabs[i].classList.remove('on'); tabs[i].removeAttribute('aria-current');
      i = next;
      slides[i].classList.add('on'); slides[i].inert = false;
      tabs[i].classList.add('on'); tabs[i].setAttribute('aria-current', 'true');
      const strip = tabs[i].closest('ol')!, li = tabs[i].parentElement!;
      strip.scrollTo({ left: li.offsetLeft - (strip.clientWidth - li.offsetWidth) / 2, behavior: reduce ? 'auto' : 'smooth' });
      car.querySelector('[data-ct]')!.textContent = text[i][0];
      car.querySelector('[data-cx]')!.textContent = text[i][1];
      car.querySelector('[data-cn]')!.textContent = String(i + 1);
      elapsed = 0;
    };
    car.querySelector('[data-prev]')!.addEventListener('click', () => go(i - 1, -1));
    car.querySelector('[data-next]')!.addEventListener('click', () => go(i + 1, 1));
    tabs.forEach((t, k) => t.addEventListener('click', () => go(k)));
    car.addEventListener('keydown', (e) => {
      if ((e.target as HTMLElement).closest('input, textarea, select, [contenteditable]')) return;
      if (e.key === 'ArrowLeft') { e.preventDefault(); go(i - 1, -1); }
      if (e.key === 'ArrowRight') { e.preventDefault(); go(i + 1, 1); }
    });
    // autoplay: only on screen, never while the pointer or focus is in it; any click on a screen stops it for good
    const setPaused = (p: boolean) => { paused = p; pp.setAttribute('aria-pressed', String(p)); pp.setAttribute('aria-label', p ? 'Play the slideshow' : 'Pause the slideshow'); car.classList.toggle('paused', p); };
    setPaused(paused);
    pp.addEventListener('click', () => setPaused(!paused));
    car.querySelector('[data-car-stage]')!.addEventListener('pointerdown', (e) => { if (!(e.target as Element).closest('.nav')) setPaused(true); });
    car.addEventListener('pointerenter', () => { hover = true; });
    car.addEventListener('pointerleave', () => { hover = false; });
    car.addEventListener('focusin', () => { hover = true; });
    car.addEventListener('focusout', () => { hover = false; });
    new IntersectionObserver((es) => { visible = es.some((x) => x.isIntersecting); }, { threshold: 0.4 }).observe(car);
    let last = performance.now();
    const tick = (now: number) => {
      const dt = now - last; last = now;
      if (!paused && !hover && visible && !document.hidden) elapsed += dt;
      car.style.setProperty('--p', String(Math.min(1, elapsed / DWELL)));
      if (elapsed >= DWELL) go(i + 1, 1);
      requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);
  }
</script>

<style>
  .car { --p: 0; --dir: 1; outline: none; min-width: 0; max-width: 100%; }
  .car:focus-visible .stage { box-shadow: 0 0 0 2px var(--bg), 0 0 0 4px var(--accent); }
  .stage { position: relative; height: clamp(440px, 46vw, 560px); border-radius: var(--radius-md); overflow: hidden; background: var(--bg);
    border: 1px solid var(--border-strong); box-shadow: 0 30px 80px -20px rgba(0, 0, 0, .8); }
  .slide { position: absolute; inset: 0; opacity: 0; transform: translateX(calc(var(--dir) * 4%)) scale(.985);
    transition: opacity 500ms var(--ease-out), transform 700ms var(--ease-out); pointer-events: none; }
  .slide.on { opacity: 1; transform: none; pointer-events: auto; }
  .livetag { position: absolute; z-index: 5; right: 14px; top: 12px; display: inline-flex; align-items: center; gap: 6px; padding: 4px 10px;
    border-radius: 999px; background: rgba(8, 9, 12, .7); font: 500 11.5px/1.2 var(--font-mono); color: var(--ok); pointer-events: none; }
  .livetag i { width: 7px; height: 7px; border-radius: 50%; background: var(--ok); box-shadow: 0 0 8px var(--ok); animation: blinkdot 1.6s ease-in-out infinite; }
  @keyframes blinkdot { 50% { opacity: .35; } }
  .nav { all: unset; position: absolute; z-index: 6; top: 50%; width: 42px; height: 42px; margin-top: -21px; border-radius: 50%; display: grid;
    place-items: center; cursor: pointer; color: var(--text); background: rgba(13, 14, 18, .7); backdrop-filter: blur(8px);
    border: 1px solid rgba(237, 238, 242, .2); opacity: 0; transition: opacity 220ms, background-color 220ms, transform 320ms var(--ease-back); }
  .prev { left: 10px; } .next { right: 10px; }
  .stage:hover .nav, .nav:focus-visible, .car:focus-within .nav { opacity: 1; }
  .nav:hover { background: var(--accent); color: var(--on-accent); transform: scale(1.08); }
  .nav:focus-visible { outline: 2px solid var(--accent); }
  .cap { display: flex; align-items: center; gap: 14px; margin-top: 14px; }
  .ct { margin-right: auto; color: var(--text-2); font-size: 15px; }
  .ct b { color: var(--text); font-weight: 600; margin-right: 4px; }
  .count { font: 500 13px/1 var(--font-mono); color: var(--text-2); white-space: nowrap; }
  .pp { all: unset; width: 34px; height: 34px; border-radius: 50%; display: grid; place-items: center; cursor: pointer; color: var(--text);
    border: 1px solid var(--border-strong); }
  .pp:hover { background: rgba(237, 238, 242, .06); }
  .pp:focus-visible { outline: 2px solid var(--accent); }
  .i-play { display: none; } .paused .i-play { display: block; } .paused .i-pause { display: none; }
  .tabs { list-style: none; margin: 12px 0 0; padding: 2px 2px 6px; display: flex; gap: 8px; overflow-x: auto; scrollbar-width: thin;
    scrollbar-color: var(--border-strong) transparent; }
  .tab { all: unset; display: grid; gap: 7px; min-width: 112px; padding: 9px 12px 8px; border-radius: var(--radius-sm); cursor: pointer;
    border: 1px solid var(--border); background: var(--surface); transition: border-color 220ms, background-color 220ms, transform 220ms var(--ease-out); }
  .tab:hover { border-color: var(--border-strong); transform: translateY(-2px); }
  .tab.on { border-color: rgba(255, 138, 31, .55); background: linear-gradient(90deg, rgba(58, 168, 255, .1), rgba(255, 138, 31, .1)); }
  .tab:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .tl { font-size: 13px; color: var(--text-2); white-space: nowrap; }
  .tab.on .tl { color: var(--text); font-weight: 600; }
  .bar { height: 3px; border-radius: 3px; background: var(--surface-3); overflow: hidden; }
  .bar i { display: block; height: 100%; width: 0; background: var(--portal); }
  .tab.on .bar i { width: calc(var(--p) * 100%); }
  @media (max-width: 700px) {
    .nav { opacity: 1; width: 36px; height: 36px; margin-top: -18px; }
    .stage { height: 500px; }
    .livetag { top: auto; bottom: 10px; }
    .cap { flex-wrap: wrap; }
  }
</style>
