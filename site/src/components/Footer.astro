---
import Wordmark from './Wordmark.astro';
import { REPO, RELEASES, REPORT_PROBLEM, blob, url } from '../data/site';

interface Props { credits?: boolean }
const { credits = true } = Astro.props;
const builtOn = [
  { name: 'OVRPort', href: 'https://github.com/Android-XR-Bridge/OVRPort', what: 'Quest → OpenXR (originally ovrport/app)' },
  { name: 'Valve Lepton, Proton and SteamVR', what: "the Frame's Android container, Windows layer and VR runtime" },
  { name: 'Revive', href: 'https://github.com/LibreVR/Revive', what: 'Oculus PC games on SteamVR' },
  { name: 'Mesa (Zink)', what: 'OpenGL on Vulkan' },
  { name: 'Khronos OpenXR SDK', href: 'https://github.com/KhronosGroup/OpenXR-SDK', what: 'the OpenXR loader and headers' },
  { name: 'Eclipse Temurin, Android apksigner and NDK', what: 'the build tools' },
  { name: 'Flet', href: 'https://flet.dev', what: "the app's interface" },
  { name: 'OculusDB and Steam store data', what: 'artwork and game details' },
];
---
{credits && (
  <section class="section credits" id="credits">
    <div class="wrap">
      <div class="head reveal">
        <p class="label"><b>06</b> Built on</p>
        <h2>Most of the work is theirs.</h2>
        <p class="lead">FramePort downloads these projects, wires them together and adds what the Frame needs.
          <a href={blob('docs/ARCHITECTURE.md')}>What FramePort adds itself</a></p>
      </div>
      <ul class="built reveal">
        {builtOn.map((b) => (
          <li>{b.href ? <a href={b.href}>{b.name}</a> : <span class="n">{b.name}</span>} <span class="w">{b.what}</span></li>
        ))}
      </ul>
    </div>
  </section>
)}
<footer class="footer">
  <div class="wrap foot-in">
    <div class="foot-brand">
      <Wordmark id="foot" href={url()} />
      <p>GPL-3.0-only (includes GPL-3.0 code from OVRPort). Not affiliated with Valve or Meta.</p>
    </div>
    <nav class="foot-links" aria-label="Project">
      <a href={REPO}>Source code</a>
      <a href={RELEASES}>Releases</a>
      <a href={blob('docs/INSTALL.md')}>Documentation</a>
      <a href={REPORT_PROBLEM}>Report a problem</a>
      <a href={url('install/')}>Install links</a>
    </nav>
  </div>
</footer>

<style>
  .built { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 0 40px; }
  .built li { display: grid; gap: 2px; padding: 14px 0; border-top: 1px solid var(--border); }
  .built a, .built .n { font-weight: 600; color: var(--text); text-decoration-color: rgba(255, 138, 31, 0.5); }
  .built a:hover { color: var(--accent); }
  .built .w { color: var(--text-2); font-size: 14px; }

  .footer { position: relative; background: var(--sidebar); padding: 40px 0 48px; }
  .footer::before { content: ""; position: absolute; left: 0; right: 0; top: 0; height: 2px; background: var(--portal); opacity: .6; }
  .foot-in { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 24px; align-items: flex-start; }
  .foot-brand { display: grid; gap: 12px; }
  .foot-brand p { color: var(--text-2); font-size: 13px; max-width: 46ch; }
  .foot-links { display: flex; flex-wrap: wrap; gap: 8px 22px; font-size: 14px; }
  .foot-links a { color: var(--text-2); text-decoration: none; }
  .foot-links a:hover { color: var(--text); text-decoration: underline; }
</style>
