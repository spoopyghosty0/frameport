---
// FramePort next to FrameDrop and Valve's own tools (data/compare.ts, same facts as the README's table).
import { CHECKED, ROWS, SOURCES, TOOLS, TOOL_NOTES } from '../data/compare';

const SYMBOL = { yes: '✓', no: '–', part: '◐', unknown: '?' } as const;
const LABEL = { yes: 'Yes', no: 'No', part: 'Partly', unknown: 'Not stated' } as const;
---
<section class="section" id="compare">
  <div class="wrap">
    <div class="head reveal">
      <p class="label"><b>05</b> Compared</p>
      <h2>How it differs from other ways to sideload.</h2>
      <p class="lead">FrameDrop and Valve's own tools install an app as it is. FramePort also converts and patches Meta Quest
        games that don't run on the Frame as they are, and keeps a tested recipe per game. It opens FrameDrop's install
        links too.</p>
    </div>

    <div class="cmp reveal" data-cmp data-with="both">
      <div class="with" role="group" aria-label="Compare FramePort with">
        <span>Compare FramePort with</span>
        <button type="button" data-with-btn="1" aria-pressed="false">FrameDrop</button>
        <button type="button" data-with-btn="2" aria-pressed="false">Valve’s tools</button>
        <button type="button" data-with-btn="both" aria-pressed="true">Both</button>
      </div>
      <div class="scroll">
        <table>
          <thead>
            <tr>
              <th scope="col" class="rowh"><span class="visually-hidden">Feature</span></th>
              {TOOLS.map((t, i) => (
                <th scope="col" class={`c${i}`}><b>{t}</b><span>{TOOL_NOTES[i]}</span></th>
              ))}
            </tr>
          </thead>
          <tbody>
            {ROWS.map((r) => (
              <tr>
                <th scope="row" class="rowh">{r.label}</th>
                {r.cells.map((c, i) => (
                  <td class={`c${i} m-${c.mark}`}>
                    <span class="mk" aria-label={LABEL[c.mark]} title={LABEL[c.mark]}>{SYMBOL[c.mark]}</span>
                    <span class="tx">{c.text}</span>
                  </td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="src">Other tools as described on their own pages, checked {CHECKED}:
        {SOURCES.map((s, i) => <>{i > 0 && ' · '}<a href={s.href}>{s.label}</a></>)}.
        Something out of date? <a href="https://github.com/spoopyghosty0/frameport/issues/new">Open an issue</a>.</p>
    </div>
  </div>
</section>

<script>
  const cmp = document.querySelector<HTMLElement>('[data-cmp]');
  cmp?.querySelectorAll<HTMLButtonElement>('[data-with-btn]').forEach((b) => b.addEventListener('click', () => {
    cmp.dataset.with = b.dataset.withBtn!;
    cmp.querySelectorAll('[data-with-btn]').forEach((o) => o.setAttribute('aria-pressed', String(o === b)));
  }));
  // phones: one tool next to FramePort at a time
  if (cmp && matchMedia('(max-width: 760px)').matches) cmp.querySelector<HTMLButtonElement>('[data-with-btn="1"]')?.click();
</script>

<style>
  .with { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; margin-bottom: 14px; }
  .with span { font: 600 11px/1 var(--font-mono); letter-spacing: .12em; text-transform: uppercase; color: var(--text-2); margin-right: 6px; }
  .with button { all: unset; padding: 6px 14px; border-radius: 999px; border: 1px solid var(--border-strong); font-size: 13px; color: var(--text-2);
    cursor: pointer; }
  .with button:hover { color: var(--text); }
  .with button[aria-pressed="true"] { color: var(--text); border-color: transparent;
    background: linear-gradient(90deg, rgba(58, 168, 255, .22), rgba(255, 138, 31, .22)); }
  .with button:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .scroll { overflow-x: auto; border: 1px solid var(--border); border-radius: var(--radius-md); background: var(--surface); }
  table { width: 100%; border-collapse: collapse; min-width: 640px; font-size: 14px; }
  th, td { padding: 12px 16px; text-align: left; vertical-align: top; border-top: 1px solid rgba(42, 45, 55, .7); }
  thead th { border-top: 0; background: var(--sidebar); position: relative; }
  thead th b { display: block; font: 700 16px/1.2 var(--font-display); }
  thead th span { display: block; margin-top: 2px; font-size: 12px; font-weight: 400; color: var(--text-2); }
  thead th.c0 b { color: var(--accent); }
  thead th.c0::after { content: ""; position: absolute; left: 0; right: 0; bottom: 0; height: 2px; background: var(--portal); }
  .rowh { width: 22%; font-weight: 600; color: var(--text); }
  td { width: 26%; color: var(--text-2); line-height: 1.45; }
  td.c0 { color: var(--text); background: rgba(255, 138, 31, .04); }
  td { display: table-cell; }
  td .mk { display: inline-grid; place-items: center; width: 20px; height: 20px; margin-right: 8px; border-radius: 50%; font-size: 12px;
    font-weight: 700; vertical-align: 1px; }
  .m-yes .mk { color: var(--ok); background: rgba(61, 214, 140, .14); }
  .m-no .mk { color: var(--text-2); background: var(--surface-3); }
  .m-part .mk { color: var(--warn); background: rgba(242, 201, 76, .12); }
  .m-unknown .mk { color: var(--text-2); background: transparent; border: 1px dashed var(--border-strong); }
  tbody tr:hover th, tbody tr:hover td { background-color: rgba(237, 238, 242, .03); }
  [data-with="1"] .c2, [data-with="2"] .c1 { display: none; }
  [data-with="1"] table, [data-with="2"] table { min-width: 0; }
  .src { margin-top: 14px; font-size: 13px; color: var(--text-2); max-width: 90ch; }
  @media (max-width: 760px) {
    th, td { padding: 10px 12px; }
    .rowh { width: 28%; }
  }
</style>
